# Runs the printer app server inside the snap. PAPPL keeps its state, spool
# and control socket in $SNAP_COMMON and reads
# $SNAP_COMMON/phomemo-printer-app.conf, created here from the packaged
# default at first start. The TLS certificate goes to CUPS_SERVERROOT/ssl
# (set for the whole snap). The log goes to stdout, which snapd sends to
# the journal (snap logs).

set -eu

mkdir -p "$SNAP_COMMON/cups/ssl"
if [ ! -e "$SNAP_COMMON/phomemo-printer-app.conf" ]; then
  cp "$SNAP/etc/phomemo-printer-app.conf" "$SNAP_COMMON/phomemo-printer-app.conf"
fi

exec "$SNAP/usr/bin/phomemo-printer-app" -o log-file=- server
