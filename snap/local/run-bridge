# The bridge command line inside the snap (phomemo-printer-app.bridge).
# Reads the snap's configuration file when the daemon has created it, so
# the command line never looks at the host's /etc/phomemo; the socket path
# comes from PHOMEMO_BRIDGE_SOCKET (set for the whole snap).

set -eu

if [ -r "$SNAP_COMMON/bridge.toml" ]; then
  set -- --config "$SNAP_COMMON/bridge.toml" "$@"
fi

exec "$SNAP/bin/python3.13" -m phomemo.bridge "$@"
