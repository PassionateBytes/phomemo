# Runs the bridge daemon inside the snap. The configuration file is created
# from the packaged default at first start and kept across upgrades; the
# socket path comes from PHOMEMO_BRIDGE_SOCKET (set for the whole snap).
# The bridge writes its test page PNG into XDG_RUNTIME_DIR.

set -eu

mkdir -p "$SNAP_COMMON/run"
if [ ! -e "$SNAP_COMMON/bridge.toml" ]; then
  cp "$SNAP/etc/phomemo/bridge.toml" "$SNAP_COMMON/bridge.toml"
fi

export XDG_RUNTIME_DIR="$SNAP_COMMON/run"

# bin/python3.13 is the virtual environment's interpreter; running it puts
# the library on sys.path.
exec "$SNAP/bin/python3.13" -m phomemo.bridge --config "$SNAP_COMMON/bridge.toml" server
