# User unit: install to ~/.config/systemd/user/ (make -C printer-app install
# does this for a PREFIX under $HOME), then
#   systemctl --user enable --now phomemo-printer-app
# The application reaches phomemo-bridge through the socket both units
# name in PHOMEMO_BRIDGE_SOCKET.
[Unit]
Description=Phomemo printer application (IPP side of the printer driver)
After=phomemo-bridge.service
Wants=phomemo-bridge.service

[Service]
Type=simple
ExecStart=%h/.local/bin/phomemo-printer-app server -o log-file=- -o log-level=info
Environment=PHOMEMO_BRIDGE_SOCKET=%t/phomemo-bridge.sock
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
