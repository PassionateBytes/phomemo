# System service presenting the printer to CUPS and the network (IPP,
# DNS-SD, web interface on port 8000). Talks to phomemo-bridge over its
# socket. State in /var/lib, spool in /var/spool, log in the journal.
[Unit]
Description=Phomemo printer application (IPP side of the printer driver)
Documentation=https://github.com/PassionateBytes/phomemo-driver
After=network-online.target avahi-daemon.service phomemo-bridge.service
Wants=network-online.target phomemo-bridge.service

[Service]
Type=simple
Environment=PHOMEMO_BRIDGE_SOCKET=/run/phomemo/bridge.sock
ExecStart=/usr/bin/phomemo-printer-app server -o log-file=- -o log-level=info
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
