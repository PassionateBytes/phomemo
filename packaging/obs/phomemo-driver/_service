Source service of the OBS package "phomemo-driver": checks out the newest
v* tag reachable from main, packs it as phomemo-driver-<version>.tar.gz and
takes the RPM spec and the Debian packaging files from that tag. tar_scm and
recompress run on the server (build.opensuse.org has no server-side tar
service), so no build target needs the service packages. A service
run (commit, "Trigger services" in the web UI, or the token the release
workflow uses) rebuilds every target from the newest release.
-->
<services>
  <service name="tar_scm">
    <param name="scm">git</param>
    <param name="url">https://github.com/PassionateBytes/phomemo-driver.git</param>
    <param name="revision">@PARENT_TAG@</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="versionrewrite-pattern">v(.*)</param>
    <param name="filename">phomemo-driver</param>
    <param name="extract">packaging/rpm/phomemo-driver.spec</param>
    <param name="extract">packaging/debian/phomemo-driver.dsc</param>
    <param name="extract">packaging/debian/debian.changelog</param>
    <param name="extract">packaging/debian/debian.control</param>
    <param name="extract">packaging/debian/debian.copyright</param>
    <param name="extract">packaging/debian/debian.rules</param>
    <param name="extract">packaging/debian/debian.phomemo-driver.install</param>
  </service>
  <service name="recompress">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
</services>
