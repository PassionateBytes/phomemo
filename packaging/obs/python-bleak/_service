Source service of the OBS package "python-bleak" (Fedora targets only:
Debian and Ubuntu ship python3-bleak). Takes the spec from main and
downloads the bleak release the spec names from PyPI. The package builds
only for RPM targets; its meta disables the Debian and Ubuntu repositories.
-->
<services>
  <service name="obs_scm">
    <param name="scm">git</param>
    <param name="url">https://github.com/PassionateBytes/phomemo-driver.git</param>
    <param name="revision">main</param>
    <param name="without-version">enable</param>
    <param name="extract">packaging/rpm/python-bleak.spec</param>
  </service>
  <service name="download_files"/>
</services>
