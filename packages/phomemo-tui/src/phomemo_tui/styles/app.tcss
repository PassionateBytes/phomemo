/* ── Layout ─────────────────────────────────────────────────── */

#dashboard {
    height: 1fr;
    padding: 1 2;
}

#left-column {
    width: 38%;
    height: 1fr;
}

#right-column {
    width: 62%;
    height: 1fr;
}

/* ── Panel tiles ─────────────────────────────────────────────── */

.panel {
    border: round $surface-lighten-2;
    padding: 1 2;
    margin: 0 1 1 0;
    height: 1fr;
}

.panel:focus {
    border: round $accent;
}

.panel.locked {
    opacity: 0.6;
}

/* ── Status panel ────────────────────────────────────────────── */

#panel-status {
    height: auto;
    min-height: 8;
}

/* ── Settings panel ──────────────────────────────────────────── */

#panel-settings {
    height: auto;
}

/* ── Preview panel ───────────────────────────────────────────── */

#panel-preview {
    height: 1fr;
    overflow-y: auto;
}

#preview-header {
    text-style: bold;
    margin-bottom: 1;
}

#preview-body {
    height: 1fr;
}

#preview-footer {
    margin-top: 1;
    height: auto;
}

/* ── Print button ────────────────────────────────────────────── */

#panel-print {
    height: auto;
    min-height: 3;
    content-align: center middle;
    text-align: center;
    border: round $surface-lighten-2;
}

#panel-print:focus {
    border: round $accent;
}

#panel-print.ready {
    border: round $success;
    background: $success 20%;
    color: $success;
}

#panel-print.ready:focus {
    background: $success 40%;
}

#panel-print.cancel {
    border: round $warning;
    background: $warning 20%;
    color: $warning;
}

#panel-print.cancel:focus {
    background: $warning 40%;
}

#panel-print.disabled {
    border: round $surface-lighten-1;
    color: $text-muted;
}

/* ── Scanner / Settings screens ─────────────────────────────── */

#scanner-container,
#settings-container {
    padding: 1 2;
    height: 1fr;
}

#scan-status {
    margin-bottom: 1;
    text-style: bold;
}

#device-list {
    height: 1fr;
    margin-bottom: 1;
}

ListItem.dim {
    opacity: 0.4;
}

/* ── Shared ──────────────────────────────────────────────────── */

.section-title {
    text-style: bold;
    margin-bottom: 1;
}
