// Renovate (Mend Renovate GitHub app), weekly. Only uv.lock moves within
// the ranges in pyproject.toml, with one exception: the runtime
// dependencies (bleak, pillow) are capped below their next major version,
// and a new major comes as a pull request that raises the cap (lower bound
// kept) and waits for review. Their minor and patch updates arrive with the
// weekly lock refresh. Development and documentation tools are uncapped:
// CI catches what a new version breaks, and none of them reaches users.
// Everything else merges on its own once CI is green; GitHub Actions
// majors wait for review. The Fedora releases CI runs on come from Bodhi,
// not from a pinned version.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  timezone: "Europe/Amsterdam",
  schedule: ["before 6am on monday"],
  semanticCommits: "enabled",
  rangeStrategy: "in-range-only",
  automergeType: "pr",
  automergeStrategy: "squash",
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    schedule: ["before 6am on monday"],
  },
  packageRules: [
    {
      description: "Minor and patch updates merge once CI is green.",
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
    },
    {
      // Renovate cannot limit a rangeStrategy to major updates, so widen
      // applies to every update of these two: in-range versions leave the
      // range alone and come with the lock refresh. uv.lock pins the bleak
      // version COPR's python-bleak package is built at (.copr/Makefile);
      // CI builds and installs that package.
      description: "Runtime dependencies: a new major raises the cap, for review.",
      matchPackageNames: ["bleak", "pillow"],
      rangeStrategy: "widen",
      labels: ["runtime dependency"],
    },
    {
      description: "Development tools in one pull request, majors included.",
      matchManagers: ["pep621"],
      matchDepTypes: ["dependency-groups"],
      groupName: "development tools",
      automerge: true,
    },
    {
      description: "Documentation tooling in one pull request, majors included.",
      matchFileNames: ["docs/pyproject.toml"],
      groupName: "documentation tooling",
      automerge: true,
    },
    {
      description: "GitHub Actions in one pull request.",
      matchManagers: ["github-actions"],
      matchDepTypes: ["action"],
      groupName: "GitHub Actions",
    },
    {
      // The printer app is written against PAPPL 1.4; a new minor or major
      // may change the API or the behaviour the snap relies on.
      description: "PAPPL in the snap: patch releases merge, anything bigger waits for review.",
      matchPackageNames: ["michaelrsweet/pappl"],
      matchUpdateTypes: ["major", "minor"],
      automerge: false,
    },
  ],
  customManagers: [
    {
      description: "The PAPPL release tag the snap builds from (snap/snapcraft.yaml).",
      customType: "regex",
      managerFilePatterns: ["/^snap/snapcraft\\.yaml$/"],
      matchStrings: [
        "source: https://github\\.com/(?<depName>michaelrsweet/pappl)\\n\\s+source-type: git\\n\\s+source-tag: (?<currentValue>v[0-9.]+)\\n",
      ],
      datasourceTemplate: "github-tags",
    },
  ],
}
